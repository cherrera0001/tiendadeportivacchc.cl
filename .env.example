PORT=3000
PUBLIC_SITE_URL=http://localhost:3000

# Postgres de producción (Neon / Vercel). Vacío = PGlite local.
DATABASE_URL=
# CA propia en PEM solo si el proveedor no firma con CA pública (la validación TLS siempre va activa)
DATABASE_CA_CERT=

# Mercado Pago (Checkout Pro). Vacío = simulación local si ALLOW_PAYMENT_SIMULATION=true
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Cloudflare Turnstile. Vacío = no se verifica en local
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Solo desarrollo: confirmar un pedido pendiente sin MP.
# Requiere valor exacto "true"; en producción se ignora siempre.
ALLOW_PAYMENT_SIMULATION=true

# Token para GET /api/metricas y metricas.html.
# Vacío en local = abierto; en producción sin token el endpoint responde 401.
METRICAS_TOKEN=

# Cloudflare R2 (v3 M8). Vacío = no hay object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
