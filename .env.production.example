# ========== VARIABLES DE PRODUCCIÓN (Vercel + Supabase) ==========
# Copiar estas variables a Vercel → Settings → Environment Variables
# NO commit este archivo con valores reales (riesgo de credenciales en git)

# ========== SERVIDOR ==========
PORT=3000
PUBLIC_SITE_URL=https://tiendadeportivacchc.cl
NODE_ENV=production

# ========== BASE DE DATOS (Supabase PostgreSQL con pgbouncer) ==========
# Obtener de: Supabase Dashboard → Settings → Database → Connection String
# Usar la versión "Pooling" (pgbouncer) para Vercel
DATABASE_URL=postgresql://postgres.XXXXXXXXX:YYYYYYYYYY@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# ========== MERCADO PAGO (Producción - Live, no sandbox) ==========
# Obtener de: https://www.mercadopago.com/settings/account/credentials (modo live)
MP_ACCESS_TOKEN=APP_USR_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MP_PUBLIC_KEY=APP_USR_YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
MP_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ========== CLOUDFLARE TURNSTILE (verificación de formularios) ==========
# Obtener de: https://dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=0x4AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ========== SEGURIDAD ==========
# NUNCA permitir simulación de pago en producción
ALLOW_PAYMENT_SIMULATION=false

# ========== Opcional: Cloudflare R2 (para archivos futuros - M8) ==========
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_PUBLIC=
# R2_BUCKET_PRIVATE=
